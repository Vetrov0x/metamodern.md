---
interface Props {
  title: string;
  description: string;
  canonicalURL: URL;
  ogImage?: string;
  ogType?: string;
  lang?: string;
  alternates?: Array<{ lang: string; href: string }>;
  publishedTime?: Date;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonicalURL,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  lang = 'en',
  alternates = [],
  publishedTime,
  author,
  tags = [],
} = Astro.props;

const siteName = 'metamodern.md';
const fullOgImage = new URL(ogImage, Astro.site).href;
const ogLocaleMap: Record<string, string> = { en: 'en_US', ru: 'ru_RU', fr: 'fr_FR' };
const ogLocale = ogLocaleMap[lang] || 'en_US';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: 'https://metamodern.md/',
  description,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{fullOgImage && <meta name="twitter:image" content={fullOgImage} />}

{alternates.map(alt => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}

{ogType === 'website' && (
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
)}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Metamodern Movement',
  alternateName: ['Metamodern', 'metamodern.md'],
  url: 'https://metamodern.md',
  description: 'The philosophical movement of Metamodern Company: the manifest, the principles, and the Metamodern Constitution.',
  foundingDate: '2020',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Metamodern Company',
    url: 'https://metamodern.company',
  },
  sameAs: [
    'https://metamodern.company',
    'https://metamodern.studio',
    'https://metamodern.store',
    'https://metamodern.foundation',
    'https://conscience.md',
    'https://metapolis.md',
    'https://crabhouse.dev',
    'https://www.linkedin.com/company/metamodern-company/',
    'https://x.com/Metamodern0x',
    'https://www.instagram.com/metamodern.studio/',
    'https://www.instagram.com/metamodern.times/',
    'https://t.me/metamodern_studio',
    'https://t.me/metamodern_times',
  ],
})} />

{ogType === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: fullOgImage,
    datePublished: publishedTime?.toISOString(),
    author: {
      '@type': 'Person',
      name: author || 'Aletheia',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Metamodern',
      url: 'https://metamodern.company',
    },
    keywords: tags.join(', '),
  })} />
)}

<link rel="alternate" type="application/rss+xml" title={siteName} href="/feed.xml" />
